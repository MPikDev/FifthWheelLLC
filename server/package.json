{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "description": "Express server for Fifth Wheel LLC quote requests.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "nodemailer": "^7.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
