# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on (Vite proxies /api to it in development).
PORT=3001

# Where quote requests are emailed.
DISPATCH_EMAIL=dispatch@example.com

# "From" address on quote emails. Most SMTP providers require this to be an
# address on a domain you've verified with them.
MAIL_FROM="Fifth Wheel Website <no-reply@example.com>"

# SMTP settings from your email provider (Gmail, Outlook, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Rate limiting: max quote submissions per IP per window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15

# Set to true only when running behind a reverse proxy (nginx, Caddy, a hosting
# platform) so rate limiting sees visitors' real IP addresses.
TRUST_PROXY=false
